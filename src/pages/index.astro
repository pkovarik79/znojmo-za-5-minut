---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { categories, selectedEvents } from "../data/site";
import { sourceLabel } from "../lib/sourceLabels";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const homepageArticles = articles.slice(0, 5);
const usedCategories = categories.filter((category) => homepageArticles.some((article) => article.data.category === category.id));

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("cs-CZ", { day: "numeric", month: "long", year: "numeric" }).format(new Date(`${date}T12:00:00Z`));

const categoryLabel = (categoryId: string) =>
  categories.find((category) => category.id === categoryId)?.label ?? "Zprávy";
---

<BaseLayout>
  <section class="home-hero border-b border-stone-200">
    <div class="mx-auto max-w-6xl px-5">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#9b3324]">Znojmo a okolí</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-black leading-[1.02] text-[#171717] md:text-5xl">Zprávy ze Znojma a okolí</h1>
      <p class="mt-5 max-w-2xl font-serif text-xl leading-8 text-stone-700">Krátký výběr aktuálních zpráv, akcí a událostí ze Znojma a okolí.</p>
    </div>
  </section>

  <section class="home-hero-photo-section">
    <div class="mx-auto max-w-6xl px-5">
      <img
        class="home-hero-photo"
        src="/images/znojmo-header.jpg"
        alt="Panorama Znojma"
        loading="eager"
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5">
    <div class="mb-8 flex flex-col gap-4 border-b border-stone-200 pb-5 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-2xl font-black text-[#171717]">Aktuálně</h2>
        <div class="mt-4 flex flex-wrap gap-2" data-filter-bar>
          <button class="rounded-full border border-[#9b3324] bg-[#9b3324] px-3 py-1 text-sm font-bold text-white" type="button" data-filter="all">Vše</button>
          {usedCategories.map((category) => (
            <button class="rounded-full border border-stone-300 px-3 py-1 text-sm font-bold text-stone-700 hover:border-[#9b3324] hover:text-[#9b3324]" type="button" data-filter={category.id}>
              {category.label}
            </button>
          ))}
        </div>
      </div>
      <a class="text-sm font-bold text-[#9b3324] hover:underline" href="/articles">Archiv článků</a>
    </div>

    <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
      <div>
        <div class="divide-y divide-stone-200" data-article-list>
          {homepageArticles.map((article, index) => (
            <article class:list={["grid gap-4 py-7 md:grid-cols-[150px_1fr]", index === 0 && "pt-0"]} data-category={article.data.category}>
              <div class="space-y-2">
                <p class="text-sm text-stone-500">{formatDate(article.data.date)}</p>
                <p class="text-xs font-black uppercase tracking-[0.14em] text-[#9b3324]">{categoryLabel(article.data.category)}</p>
              </div>
              <div>
                <h3 class:list={["max-w-3xl font-black leading-tight text-[#171717]", index === 0 ? "text-3xl md:text-4xl" : "text-2xl"]}>
                  <a class="hover:text-[#9b3324]" href={`/articles/${article.slug}`}>{article.data.title}</a>
                </h3>
                <p class:list={["mt-3 max-w-3xl font-serif leading-8 text-stone-700", index === 0 ? "text-xl" : "text-lg"]}>{article.data.excerpt ?? article.data.answerText}</p>
                <p class="mt-4 text-sm text-stone-500">Zdroj: {sourceLabel(article.data.sourceName)}, {formatDate(article.data.sourceDate)}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <aside class="space-y-10">
        <section class="border-t-4 border-[#123d2a] pt-5">
          <h2 class="text-2xl font-black text-[#171717]">Vybrané akce</h2>
          <div class="mt-5 divide-y divide-stone-200">
            {selectedEvents.map((event) => (
              <article class="py-4 first:pt-0">
                <p class="text-sm font-bold text-[#9b3324]">{event.date}</p>
                <h3 class="mt-1 text-xl font-black leading-tight text-[#171717]">
                  <a class="hover:text-[#9b3324]" href={event.url}>{event.title}</a>
                </h3>
                <p class="mt-2 text-sm leading-6 text-stone-600">{event.place} · {event.source}</p>
              </article>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </section>
  <script>
    const buttons = document.querySelectorAll("[data-filter]");
    const articles = document.querySelectorAll("[data-article-list] [data-category]");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.getAttribute("data-filter");

        buttons.forEach((item) => {
          item.classList.remove("border-[#9b3324]", "bg-[#9b3324]", "text-white");
          item.classList.add("border-stone-300", "text-stone-700");
        });

        button.classList.add("border-[#9b3324]", "bg-[#9b3324]", "text-white");
        button.classList.remove("border-stone-300", "text-stone-700");

        articles.forEach((article) => {
          const visible = filter === "all" || article.getAttribute("data-category") === filter;
          article.classList.toggle("hidden", !visible);
        });
      });
    });
  </script>
</BaseLayout>
