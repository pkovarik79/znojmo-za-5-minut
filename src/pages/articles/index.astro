---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categories } from "../../data/site";
import { sourceLabel } from "../../lib/sourceLabels";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("cs-CZ", { day: "numeric", month: "long", year: "numeric" }).format(new Date(`${date}T12:00:00Z`));

const usedCategories = categories.filter((category) => articles.some((article) => article.data.category === category.id));

const categoryLabel = (categoryId: string) =>
  categories.find((category) => category.id === categoryId)?.label ?? "Zprávy";
---

<BaseLayout title="Články | 2city">
  <section class="mx-auto max-w-5xl px-5 py-12 md:py-16">
    <div class="border-b border-stone-200 pb-6">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#9b3324]">Archiv</p>
      <h1 class="mt-4 text-4xl font-black leading-none text-[#171717] md:text-5xl">Všechny články</h1>
      <div class="mt-6 flex flex-wrap gap-2" data-filter-bar>
        <button class="rounded-full border border-[#9b3324] bg-[#9b3324] px-3 py-1 text-sm font-bold text-white" type="button" data-filter="all">Vše</button>
        {usedCategories.map((category) => (
          <button class="rounded-full border border-stone-300 px-3 py-1 text-sm font-bold text-stone-700 hover:border-[#9b3324] hover:text-[#9b3324]" type="button" data-filter={category.id}>
            {category.label}
          </button>
        ))}
      </div>
    </div>
    <div class="mt-8">
      <h2 class="border-b border-stone-300 pb-3 text-2xl font-black text-[#171717]" data-archive-heading>Nejnovější články</h2>
      <div class="divide-y divide-stone-200" data-archive-list>
        {articles.map((article) => (
          <article class="grid gap-4 py-8 md:grid-cols-[170px_1fr]" data-category={article.data.category}>
            <p class="text-sm text-stone-500">{formatDate(article.data.date)}</p>
            <div>
              <p class="mb-2 text-xs font-black uppercase tracking-[0.14em] text-[#9b3324]">{categoryLabel(article.data.category)}</p>
              <h3 class="max-w-3xl text-3xl font-black leading-tight text-[#171717]">
                <a class="hover:text-[#9b3324]" href={`/articles/${article.slug}`}>{article.data.title}</a>
              </h3>
              <p class="mt-3 max-w-3xl font-serif text-lg leading-8 text-stone-700">{article.data.excerpt ?? article.data.answerText}</p>
              <p class="mt-4 text-sm text-stone-500">Zdroj: {sourceLabel(article.data.sourceName)}, {formatDate(article.data.sourceDate)}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <script>
    const buttons = document.querySelectorAll("[data-filter]");
    const articles = document.querySelectorAll("[data-archive-list] [data-category]");
    const heading = document.querySelector("[data-archive-heading]");
    const labels: Record<string, string> = {
      all: "Nejnovější články",
      kultura: "Kultura",
      sport: "Sport",
      akce: "Akce",
      servis: "Servis",
      zpravy: "Zprávy"
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.getAttribute("data-filter");

        buttons.forEach((item) => {
          item.classList.remove("border-[#9b3324]", "bg-[#9b3324]", "text-white");
          item.classList.add("border-stone-300", "text-stone-700");
        });

        button.classList.add("border-[#9b3324]", "bg-[#9b3324]", "text-white");
        button.classList.remove("border-stone-300", "text-stone-700");

        if (heading && filter) {
          heading.textContent = labels[filter] ?? "Nejnovější články";
        }

        articles.forEach((article) => {
          const visible = filter === "all" || article.getAttribute("data-category") === filter;
          article.classList.toggle("hidden", !visible);
        });
      });
    });
  </script>
</BaseLayout>
